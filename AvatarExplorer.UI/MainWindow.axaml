<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AvatarExplorer.UI.MainWindow"
        Title="VRC Avatar Explorer v2.0.0-beta"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        Width="1280"
        Height="720">

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Bottom" Padding="10">
                <Grid ColumnDefinitions="*,20,*,20,*,20,*,20,120,20,120,20,*" Height="60" Margin="10,0,10,0">

                    <Button Grid.Column="0" Content="CSVに出力" Tag="UI.OutputToCSV" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40"/>
                    <Button Grid.Column="2" Content="バックアップの作成" Tag="UI.MakeBackup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40"/>
                    <Button Grid.Column="4" Content="共通素体の管理" Tag="UI.ManageCommonAvatar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40"/>
                    <Button Grid.Column="6" Content="データを読み込む" Tag="UI.LoadData" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40"/>

                    <StackPanel Grid.Column="8" Orientation="Vertical">
                        <TextBlock Text="言語 / Language" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="120">
                            <ComboBoxItem Content="日本語"/>
                            <ComboBoxItem Content="英語"/>
                            <ComboBoxItem Content="韓国語"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="10" Orientation="Vertical">
                        <TextBlock Text="並び替え順" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="120">
                            <ComboBoxItem Content="タイトル" Tag="UI.SortOrder.Title"/>
                            <ComboBoxItem Content="作者" Tag="UI.SortOrder.Author"/>
                            <ComboBoxItem Content="登録日時" Tag="UI.SortOrder.Created"/>
                            <ComboBoxItem Content="更新日時" Tag="UI.SortOrder.Updated"/>
                            <ComboBoxItem Content="実装済み" Tag="UI.SortOrder.Implemented"/>
                            <ComboBoxItem Content="未実装" Tag="UI.SortOrder.NotImplemented"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="12" Content="アイテムを追加する" Tag="UI.AddItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40"/>

                </Grid>
            </Border>

            <Grid DockPanel.Dock="Top" Margin="10" ColumnDefinitions="Auto,*,Auto,250">
                <Button Grid.Column="0" Content="戻る" Width="100" Margin="10,0,8,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Undo_Click"/>
                <TextBox x:Name="PathBox" Grid.Column="1" IsReadOnly="True" Text="ここには現在のパスが表示されます" Margin="10,0,8,0"/>
                <TextBlock Grid.Column="2" Text="検索" Margin="20,0,10,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/>
                <TextBox x:Name="SearchTextBox" Grid.Column="3" Watermark="検索..." TextChanged="SearchTextBox_TextChanged"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="200" Width="300"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition MinWidth="200" Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                    <ComboBox Grid.Row="0" HorizontalAlignment="Stretch" SelectedIndex="0" Margin="20,0,20,10" x:Name="LeftFilter" SelectionChanged="LeftFilter_SelectionChanged">
                        <ComboBoxItem Content="アバター" Tag="Filter.Avatar"/>
                        <ComboBoxItem Content="作者" Tag="Filter.Author"/>
                        <ComboBoxItem Content="カテゴリ" Tag="Filter.Category"/>
                    </ComboBox>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel x:Name="LeftPanel" Spacing="5"/>
                    </ScrollViewer>
                </Grid>

                <GridSplitter Grid.Column="1" Width="5" Background="#444"/>

                <ScrollViewer Grid.Column="2">
                    <Grid>
                        <StackPanel x:Name="RightPanelParent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="False"/>
                        <StackPanel x:Name="RightPanel" Spacing="8"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    
        <Border x:Name="ProgressOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="false">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ProgressBarTitle" Text="読み込み中..." Foreground="White" VerticalAlignment="Center" Margin="0,10,0,10" HorizontalAlignment="Center" FontSize="17" FontWeight="Bold"/>
                    <ProgressBar x:Name="ProgressBar" Value="0" IsIndeterminate="true" Width="300"/>
                </StackPanel>
            </Border>
        </Border>
        
        <Border x:Name="DialogOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="false">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="DialogTitle" Text="Dialog Title" Foreground="white" FontSize="24" Margin="0,0,0,10" FontWeight="Bold"/>
                    <TextBlock x:Name="DialogContent" Text="Content" Foreground="white" FontSize="17" Margin="0,0,0,10" MinWidth="300"/>
                    <Button Content="OK" HorizontalAlignment="Right" Margin="0,0,0,0" Click="DialogOK_Click" Width="60" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="AddItemOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="false">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="アイテムの追加" Foreground="White" VerticalAlignment="Top" Margin="0,10,0,10" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>

                    <Grid ColumnDefinitions="85,Auto,*,Auto" RowDefinitions="*,10,*,10,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="フォルダ" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Watermark="アイテムのパス" Margin="10,0,0,0" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="+{0}件" Margin="10,0,0,0" Foreground="White" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Button Grid.Row="0" Grid.Column="3" Content="フォルダを開く" Margin="10,0,0,0" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="マテリアル" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Watermark="アイテムのマテリアルパス" Margin="10,0,0,0" Width="250" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Button Grid.Row="2" Grid.Column="3" Content="フォルダを開く" Margin="10,0,0,0" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Booth URL" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Watermark="https://booth.pm/ja/items/123456" HorizontalAlignment="Stretch" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Booth アイテム情報" Foreground="White" VerticalAlignment="Top" Margin="0,10,0,10" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>

                    <Grid ColumnDefinitions="85,*" RowDefinitions="*,10,*,10,*,10,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="タイトル" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Watermark="タイトル未取得" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="作者" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Watermark="作者未取得" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="タイプ" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Margin="10,0,0,0" Width="190" SelectedIndex="0">
                            <ComboBoxItem Content="アバター"/>
                            <ComboBoxItem Content="衣装"/>
                        </ComboBox>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="対応アバター" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <Button Grid.Row="6" Grid.Column="1" Content="選択" Margin="10,0,0,0" Width="130" HorizontalContentAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,10,*,10,*" Margin="10,10,10,0" Height="50">
                        <Button Grid.Column="0" Content="カスタムで追加" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="情報を取得" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="4" Content="追加" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
