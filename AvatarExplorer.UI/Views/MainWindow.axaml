<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AvatarExplorer.UI.MainWindow"
        Title="VRC Avatar Explorer v2.0.0-beta"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        DragDrop.DragEnter="Main_DragDrop_Enter"
        DragDrop.Drop="Main_DragDrop_Drop"
        Closing="Main_Closing"
        Width="1280"
        Height="720">

    <Grid>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="10" ColumnDefinitions="10,Auto,10,*,20,Auto,10,200,10,50,5">
                <Button Grid.Column="1" Content="戻る" Width="100" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Main_UndoButton_Click"/>
                <TextBox x:Name="Main_PathTextBox" Grid.Column="3" IsReadOnly="True" Text="ここには現在のパスが表示されます"/>
                <TextBlock Grid.Column="5" Text="検索" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/>
                <TextBox x:Name="Main_SearchTextBox" Grid.Column="7" Watermark="検索..." TextChanged="Main_SearchTextBox_TextChanged"/>
                <Button Grid.Column="9" Content="設定" Width="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Main_SettingsButton_Click"/>
            </Grid>

            <Border DockPanel.Dock="Bottom" Padding="10">
                <Grid ColumnDefinitions="*,20,*,20,*,20,*,20,120,20,120,20,*" Height="60" Margin="10,0,10,0">

                    <Button Grid.Column="0" Content="CSVに出力" Tag="UI.ExportDataToCsv" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40" Click="Main_ExportDataToCsv_Click"/>
                    <Button Grid.Column="2" Content="バックアップの作成" Tag="UI.MakeBackup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40"/>
                    <Button Grid.Column="4" Content="共通素体の管理" Tag="UI.ManageCommonAvatar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40"/>
                    <Button Grid.Column="6" Content="データを読み込む" Tag="UI.LoadData" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40" Click="Main_ImportData_Click"/>

                    <StackPanel Grid.Column="8" Orientation="Vertical">
                        <TextBlock Text="言語 / Language" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ComboBox x:Name="Main_LanguageComboBox" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SelectionChanged="Main_LanguageComboBox_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="10" Orientation="Vertical">
                        <TextBlock Text="並び替え順" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <ComboBox x:Name="Main_SortOrderComboBox" SelectedIndex="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" SelectionChanged="Main_SortOrderComboBox_Changed">
                            <ComboBoxItem Content="タイトル" Tag="UI.SortOrder.Title"/>
                            <ComboBoxItem Content="作者" Tag="UI.SortOrder.Author"/>
                            <ComboBoxItem Content="登録日時" Tag="UI.SortOrder.Created"/>
                            <ComboBoxItem Content="更新日時" Tag="UI.SortOrder.Updated"/>
                            <ComboBoxItem Content="実装済み" Tag="UI.SortOrder.Implemented"/>
                            <ComboBoxItem Content="未実装" Tag="UI.SortOrder.NotImplemented"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="12" Content="アイテムを追加する" Tag="UI.AddItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="40" Click="Main_AddItem_Click"/>

                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="200" Width="300"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition MinWidth="200" Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                    <ComboBox Grid.Row="0" HorizontalAlignment="Stretch" SelectedIndex="0" Margin="20,0,20,10" x:Name="Main_LeftFilter" SelectionChanged="Main_LeftFilter_SelectionChanged">
                        <ComboBoxItem Content="アバター" Tag="Filter.Avatar"/>
                        <ComboBoxItem Content="作者" Tag="Filter.Author"/>
                        <ComboBoxItem Content="カテゴリ" Tag="Filter.Category"/>
                    </ComboBox>

                    <ScrollViewer x:Name="Main_LeftPanelScrollViewer" Grid.Row="1">
                        <StackPanel x:Name="Main_LeftPanel" Spacing="5"/>
                    </ScrollViewer>
                </Grid>

                <GridSplitter Grid.Column="1" Width="5" Background="#444"/>

                <ScrollViewer x:Name="Main_RightPanelScrollViewer" Grid.Column="2">
                    <Grid>
                        <StackPanel x:Name="Main_RightPanelParent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="False"/>
                        <StackPanel x:Name="Main_RightPanel" Spacing="8"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- アイテム追加画面 -->
        <Border x:Name="AddItemOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" PointerPressed="">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">

                    <!-- メイン -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,10">
                        <TextBlock Text="アイテムの追加" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                    </Grid>

                    <Grid ColumnDefinitions="85,250,*" RowDefinitions="*,10,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="フォルダ" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AddItemOverlay_FolderNamesTextBlock" Grid.Row="0" Grid.Column="1" Text="何も選択されていません" Margin="10,0,0,0" Width="250" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="Bold"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="編集" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="AddItemOverlay_EditFolder_Click"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Booth URL" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox x:Name="AddItemOverlay_BoothLinkTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Watermark="https://booth.pm/ja/items/123456" HorizontalAlignment="Stretch" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Boothアイテム情報 -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10" Margin="0,10,0,10">
                        <TextBlock Text="Booth アイテム情報" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="情報を取得" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Click="AddItemOverlay_GetBoothItemData_Click"/>
                        <Button Grid.Column="2" x:Name="AddItemOverlay_ResetBoothItemDataButton" Content="情報をリセット" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="AddItemOverlay_ResetBoothItemData_Click" IsVisible="False"/>
                    </Grid>

                    <Grid ColumnDefinitions="85,10,325" RowDefinitions="*,10,*,10,*,10,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="タイトル" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox x:Name="AddItemOverlay_BoothItemTitleTextBox" Grid.Row="0" Grid.Column="2" Watermark="タイトル未取得" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="作者" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox x:Name="AddItemOverlay_BoothItemAuthorTextBox" Grid.Row="2" Grid.Column="2" Watermark="作者未取得" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="タイプ" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <ComboBox x:Name="AddItemOverlay_ItemTypeComboBox" MinWidth="190" SelectedIndex="0"/>
                            <Button Content="追加する" MinWidth="100" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="AddItemOverlay_AddCustomCategory_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="対応アバター" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                        <Button x:Name="AddItemOverlay_EditSupportedAvatarsButton" Grid.Row="6" Grid.Column="2" Content="選択" Width="130" HorizontalContentAlignment="Center" Click="AddItemOverlay_EditSupportedAvatars_Click"/>
                    </Grid>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,20,10,0">
                        <Button Grid.Column="0" Content="閉じる" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="15" Padding="10" MinWidth="100" Click="AddItemOverlay_Close_Click"/>
                        <Button Grid.Column="2" Content="追加" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="15" Padding="10" MinWidth="100" Click="AddItemOverlay_Confirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- フォルダー追加画面 -->
        <Border x:Name="EditFoldersOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" PointerPressed="">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="450" Height="600">
                <Grid RowDefinitions="50,20,*,10,50" ColumnSpacing="10">

                    <!-- 上のボタン -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,10" ColumnSpacing="10" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="フォルダ一覧" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                        <Button Grid.Column="2" Content="フォルダを開く" Margin="10,0,0,0" VerticalAlignment="Center" Click="EditFoldersOverlay_AddFolder_Click"/>
                        <Button Grid.Column="3" Content="ファイルを開く" Margin="10,0,20,0" VerticalAlignment="Center" Click="EditFoldersOverlay_AddFile_Click"/>
                    </Grid>

                    <!-- フォルダーリスト -->
                    <ScrollViewer Grid.Row="2">
                        <Grid x:Name="EditFoldersOverlay_FolderList" RowSpacing="10"/>
                    </ScrollViewer>

                    <!-- 下のボタン -->
                    <Button Grid.Row="5" Content="閉じる" Margin="0,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Right" HorizontalContentAlignment="Center" FontWeight="Bold" MinWidth="100" Click="EditFoldersOverlay_ConfirmButton_Click"/>
                </Grid>
            </Border>
        </Border>

        <!-- カスタムカテゴリ追加画面 -->
        <Border x:Name="AddCustomCategoryOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" PointerPressed="">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,20,Auto" Margin="0,10,0,10">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="カスタムカテゴリを追加する" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>

                        <!-- カスタムカテゴリ名 -->
                        <TextBox x:Name="AddCustomCategory_CustomCategoryTextBox" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Watermark="カスタムカテゴリ名" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="200,*,200" Grid.Row="4" Margin="10,0,10,0">
                            <Button Grid.Column="0" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Left"  HorizontalContentAlignment="Center" FontSize="15" FontWeight="Bold" Click="AddCustomCategory_Cancel_Click"/>
                            <Button Grid.Column="2" Content="追加" VerticalAlignment="Center" HorizontalAlignment="Right" HorizontalContentAlignment="Center" FontSize="15" FontWeight="Bold" Click="AddCustomCategory_Add_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 対応アバター編集画面 -->
        <Border x:Name="EditSupportedAvatarsOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" PointerPressed="">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="800">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,10,Auto,20,Auto" Margin="0,10,0,10">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="対応アバターの選択" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                        
                        <!-- 検索バー -->
                        <TextBox x:Name="EditSupportedAvatarsOverlay_SearchTextBox" Grid.Row="2" Watermark="検索" TextChanged="EditSupportedAvatarsOverlay_SearchTextBox_Changed"/>

                        <!-- アバターリスト -->
                        <ScrollViewer Grid.Row="4" Height="500">
                            <Grid>
                                <StackPanel x:Name="EditSupportedAvatarsOverlay_AvatarsList" Spacing="8"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="200,*,200" Grid.Row="6" Margin="10,0,10,0">
                            <Button Grid.Column="0" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Left" HorizontalContentAlignment="Center" FontSize="15" FontWeight="Bold" Click="EditSupportedAvatarsOverlay_Cancel_Click"/>
                            <Button Grid.Column="2" Content="確定" VerticalAlignment="Center" HorizontalAlignment="Right" HorizontalContentAlignment="Center" FontSize="15" FontWeight="Bold" Click="EditSupportedAvatarsOverlay_Confirm_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 実装アバター編集画面 -->
        <Border x:Name="EditImplementedAvatarsOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" PointerPressed="">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="800">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,10,Auto,20,Auto" Margin="0,10,0,10">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="実装アバターの選択" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                        
                        <!-- 検索バー -->
                        <TextBox x:Name="EditImplementedAvatarsOverlay_SearchTextBox" Grid.Row="2" Watermark="検索" TextChanged="EditImplementedAvatarsOverlay_SearchTextBox_Changed"/>

                        <!-- アバターリスト -->
                        <ScrollViewer Grid.Row="4" Height="500">
                            <Grid>
                                <StackPanel x:Name="EditImplementedAvatarsOverlay_AvatarsList" Spacing="8"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="200,*,200" Grid.Row="6" Margin="10,0,10,0">
                            <Button Grid.Row="4" Grid.Column="0" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Left" HorizontalContentAlignment="Center" FontSize="15" FontWeight="Bold" Click="EditImplementedAvatarsOverlay_Cancel_Click"/>
                            <Button Grid.Row="4" Grid.Column="2" Content="確定" VerticalAlignment="Center" HorizontalAlignment="Right" HorizontalContentAlignment="Center" FontSize="15" FontWeight="Bold" Click="EditImplementedAvatarsOverlay_Confirm_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- アイテムメモ追加画面 -->
        <Border x:Name="AddMemoOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" PointerPressed="">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="600">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,20,Auto" Margin="0,10,0,10">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="メモの追加" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                        
                        <!-- メモテキスト -->
                        <ScrollViewer Grid.Row="2" Height="200">
                            <TextBox x:Name="AddMemoOverlay_MemoTextBox" Grid.Row="2" Watermark="メモ" AcceptsReturn="True"/>
                        </ScrollViewer>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="200,*,200" Grid.Row="4" Margin="10,0,10,0">
                            <Button Grid.Column="0" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Left" HorizontalContentAlignment="Center" FontSize="15" FontWeight="Bold" Click="AddMemoOverlay_Cancel_Click"/>
                            <Button Grid.Column="2" Content="確定" VerticalAlignment="Center" HorizontalAlignment="Right" HorizontalContentAlignment="Center" FontSize="15" FontWeight="Bold" Click="AddMemoOverlay_Confirm_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- アイテムタグ編集画面 -->
        <Border x:Name="EditTagsOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" PointerPressed="">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Width="400">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,50,Auto,10,Auto,10,Auto,20,Auto" Margin="0,10,0,10">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="アイテムタグの編集" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>

                        <!-- アイテムタグリスト -->
                        <WrapPanel x:Name="EditTagsOverlay_TagList" Grid.Row="2" VerticalAlignment="Stretch" LineSpacing="10" ItemSpacing="10">
                        </WrapPanel>

                        <TextBlock Text="タグの追加" Grid.Row="4" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold"/>
                        <TextBox x:Name="EditTagsOverlay_TagTextBox" Grid.Row="6" Watermark="タグ" KeyDown="EditTagsOverlay_TagTextBox_KeyDown"/>
                        <ComboBox x:Name="EditTagsOverlay_TagComboBox" PlaceholderText="追加したいタグを選択してください" Grid.Row="8" HorizontalAlignment="Stretch" SelectionChanged="EditTagsOverlay_TagComboBox_SelectionChanged"/>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="100,*,100" Grid.Row="10" Margin="10,0,10,0">
                            <Button Grid.Column="0" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Left"  HorizontalContentAlignment="Center" FontSize="15" FontWeight="Bold" Click="EditTagsOverlay_Cancel_Click"/>
                            <Button Grid.Column="2" Content="確定" VerticalAlignment="Center" HorizontalAlignment="Right" HorizontalContentAlignment="Center" FontSize="15" FontWeight="Bold" Click="EditTagsOverlay_Confirm_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 設定画面 -->
        <Border x:Name="SettingsOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" PointerPressed="">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">
                    <ScrollViewer MaxHeight="500">
                        <StackPanel>

                            <!-- パス設定 -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,10">
                                <TextBlock Text="パス設定" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                            </Grid>

                            <Grid ColumnDefinitions="200,10,*,10,Auto">
                                <TextBlock Grid.Column="0" TextWrapping="Wrap" Text="データ保存先フォルダ" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                <TextBox x:Name="SettingsOverlay_ItemsFolderPathTextBox" IsReadOnly="True" Grid.Column="2" MinWidth="300" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Button Grid.Column="4" Content="フォルダを開く" VerticalAlignment="Center" Margin="0,0,20,0" Click="SettingsOverlay_OpenFolder_Click"/>
                            </Grid>

                            <!-- アイテム設定 -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,30,0,10">
                                <TextBlock Text="アイテム設定" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                            </Grid>

                            <Grid ColumnDefinitions="200,10,*" RowDefinitions="*,20,*,20,*">
                                <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Text="タイトルの括弧を削除する" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                <ToggleSwitch x:Name="SettingsOverlay_RemoveBracketsCheckBox" Grid.Row="0" Grid.Column="2" MinWidth="300" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            
                                <TextBlock Grid.Row="2" Grid.Column="0" TextWrapping="Wrap" Text="インポート時にオジリナルファイルを削除する" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                <ToggleSwitch x:Name="SettingsOverlay_RemoveOriginalCheckBox" Grid.Row="2" Grid.Column="2"  Width="300" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" TextWrapping="Wrap" Text="ページあたりのアイテム表示数" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                <TextBox x:Name="SettingsOverlay_ItemsPerPageTextBox" Grid.Row="4" Grid.Column="4" Text="30" MinWidth="100" VerticalAlignment="Center" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
                            </Grid>

                            <!-- UI設定 -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,30,0,10">
                                <TextBlock Text="UI設定" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                            </Grid>

                            <Grid ColumnDefinitions="200,*" RowDefinitions="*">
                                <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Text="テーマ" Margin="0,0,10,0" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SettingsOverlay_ThemeComboBox" Grid.Row="0" Grid.Column="1" SelectedIndex="0" Margin="10,0,0,0" MinWidth="150" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="自動"/>
                                    <ComboBoxItem Content="ダーク"/>
                                    <ComboBoxItem Content="ライト"/>
                                </ComboBox>
                            </Grid>

                            <!-- デフォルト設定 -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,30,0,10">
                                <TextBlock Text="デフォルト設定" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                            </Grid>

                            <Grid ColumnDefinitions="200,*" RowDefinitions="*,20,*">
                                <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Text="言語" Margin="0,0,10,0" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SettingsOverlay_DefaultLanguageComboBox" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" MinWidth="150" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Grid>

                            <Grid ColumnDefinitions="200,*" RowDefinitions="*">
                                <TextBlock Grid.Row="2" Grid.Column="0" TextWrapping="Wrap" Text="並び替え順" Margin="0,0,10,0" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SettingsOverlay_DefaultSortOrderComboBox" Grid.Row="2" Grid.Column="1" SelectedIndex="0" Margin="10,0,0,0" MinWidth="150" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="タイトル" Tag="UI.SortOrder.Title"/>
                                    <ComboBoxItem Content="作者" Tag="UI.SortOrder.Author"/>
                                    <ComboBoxItem Content="登録日時" Tag="UI.SortOrder.Created"/>
                                    <ComboBoxItem Content="更新日時" Tag="UI.SortOrder.Updated"/>
                                    <ComboBoxItem Content="実装済み" Tag="UI.SortOrder.Implemented"/>
                                    <ComboBoxItem Content="未実装" Tag="UI.SortOrder.NotImplemented"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,50,10,0">
                        <Button CornerRadius="20" Grid.Column="0" Content="閉じる" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="15" Padding="10" MinWidth="200" Click="SettingsOverlay_Close_Click" />
                        <Button CornerRadius="20" Grid.Column="2" Content="適用" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="15" Padding="10" MinWidth="200" Click="SettingsOverlay_Apply_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- データインポート画面 -->
        <Border x:Name="SelectImportTypeOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False" PointerPressed="">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="10" Orientation="Vertical" MinWidth="300">

                    <!-- タイトル -->
                    <Grid RowDefinitions="Auto,20,Auto" Margin="0,10,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="データをインポートする" Foreground="White" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold"/>
                    </Grid>
                    
                    <!-- インポートタイプ選択ボタン -->
                    <Button Grid.Column="0" Content="Avatar Explorer V1.x.x" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Padding="10" FontWeight="Bold" Click="SelectImportTypeOverlay_FromV1_Click"/>
                    <Button Grid.Column="2" Content="KonoAsset" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Padding="10"  FontWeight="Bold" Click="SelectImportTypeOverlay_FromKonoAsset_Click"/>
                    <Button Grid.Column="4" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" Padding="10"  FontWeight="Bold" Click="SelectImportTypeOverlay_Cancel_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 進捗画面 -->
        <Border x:Name="ProgressOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">

                    <!-- タイトル -->
                    <TextBlock x:Name="ProgressBarTitle" Text="読み込み中..." Foreground="White" VerticalAlignment="Center" Margin="0,10,0,10" HorizontalAlignment="Center" FontSize="17" FontWeight="Bold"/>

                    <!-- 進捗バー -->
                    <ProgressBar x:Name="ProgressBar" Value="0" IsIndeterminate="True" Width="300"/>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- OKダイアログ -->
        <Border x:Name="DialogOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">

                    <!-- タイトル -->
                    <TextBlock x:Name="DialogTitle" Text="Dialog Title" Foreground="white" FontSize="24" Margin="0,0,0,10" FontWeight="Bold"/>

                    <!-- 内容 -->
                    <TextBlock x:Name="DialogContent" Text="Content" Foreground="white" FontSize="17" Margin="0,0,0,10" MinWidth="300"/>

                    <!-- OKボタン -->
                    <Button Content="OK" HorizontalAlignment="Right" Click="Dialog_OK_Click" MinWidth="100" Padding="16,6" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Yes/Noダイアログ -->
        <Border x:Name="YesNoDialogOverlay" Background="#80000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsVisible="False">
            <Border CornerRadius="15" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel Spacing="10">

                    <!-- タイトル -->
                    <TextBlock x:Name="YesNoDialogTitle" Text="Dialog Title" Foreground="white" FontSize="24" Margin="0,0,0,10" FontWeight="Bold"/>

                    <!-- 内容 -->
                    <TextBlock x:Name="YesNoDialogContent" Text="Content" Foreground="white" FontSize="17" Margin="0,0,0,10" MinWidth="300"/>
                    
                    <!-- Yes/Noボタン -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0,20,0">
                        <Button Content="はい" Grid.Column="0" HorizontalAlignment="Center" Click="YesNoDialog_Yes_Click" MinWidth="80" Padding="16,6" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                        <Button Content="いいえ" Grid.Column="2" HorizontalAlignment="Center" Click="YesNoDialog_No_Click" MinWidth="80" Padding="16,6" HorizontalContentAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
