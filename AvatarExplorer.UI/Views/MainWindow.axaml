<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="AvatarExplorer.UI.MainWindow"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        DragDrop.DragOver="Main_DragDrop_Over"
        DragDrop.Drop="Main_DragDrop_Drop"
        Closing="Main_Closing"
        Loaded="Main_Loaded"
        MinWidth="1280"
        MinHeight="720"
        Width="1280"
        Height="720">

    <Panel x:Name="WindowPanel" PointerPressed="Main_PointerPressed">

        <!-- メイン画面 -->
        <DockPanel Margin="12">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="1" Classes="panelbackground">
                    <Grid ColumnDefinitions="Auto,2.3*,Auto,*,Auto" ColumnSpacing="10">
                        <Button Classes="button" Grid.Column="0" Content="{materialIcons:MaterialIconExt Kind=ArrowLeft}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" CornerRadius="8" Padding="20,0,20,0" Click="Main_UndoButton_Click"/>
                        
                        <TextBox x:Name="Main_PathTextBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" IsReadOnly="True" Watermark="ここには現在のパスが表示されます" FontSize="14" CornerRadius="8"/>
                        
                        <materialIcons:MaterialIcon Grid.Column="2" Kind="Magnify" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="Main_SearchTextBox" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Watermark="入力して検索..." FontSize="14" CornerRadius="8" TextChanged="Main_SearchValue_Changed"/>
                        
                        <Button Classes="accent" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="8" Margin="5,0,0,0" Click="Main_AddItem_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <materialIcons:MaterialIcon Kind="Plus" Width="25" Height="25" VerticalAlignment="Center"/>
                                <TextBlock Classes="accent" FontSize="15" FontWeight="Bold" Text="アイテムを追加する" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Classes="panelbackground">
                    <Button Classes="button" FontWeight="Bold" Content="{materialIcons:MaterialIconExt Kind=CogOutline}" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="35" Width="35" CornerRadius="8" Click="Main_SettingsButton_Click"/>
                </Border>
            </Grid>

            <Grid Margin="0,12,-12,0">
                <Grid x:Name="Main_PanelGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="250" Width="300" MaxWidth="550"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition MinWidth="250" Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition MinWidth="50" Width="50" MaxWidth="550"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border x:Name="Main_LeftPanelBorder" Grid.Column="0" Classes="panelbackground">
                        <Grid RowDefinitions="Auto,*">
                            <TabControl x:Name="Main_LeftFilter" Grid.Row="0" HorizontalAlignment="Stretch" SelectedIndex="0" Margin="-5,-10,5,5" FontSize="18" SelectionChanged="Main_LeftFilter_SelectionChanged">
                                <TabItem Header="アバター" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Tag="Filter.Avatar"/>
                                <TabItem Header="作者" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Tag="Filter.Author"/>
                                <TabItem Header="カテゴリ" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Tag="Filter.Category"/>
                            </TabControl>

                            <ScrollViewer x:Name="Main_LeftPanelScrollViewer" Grid.Row="1">
                                <StackPanel x:Name="Main_LeftPanel" Spacing="5" Margin="0,0,10,0"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Opacity="0"/>

                    <Border x:Name="Main_RightPanelBorder" Grid.Column="2" Classes="panelbackground">
                        <ScrollViewer x:Name="Main_RightPanelScrollViewer">
                            <Panel>
                                <StackPanel x:Name="Main_RightPanelParent" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="False"/>
                                <StackPanel x:Name="Main_RightPanel" Spacing="8" Margin="0,0,10,0"/>
                            </Panel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="3" Opacity="0" IsVisible="{Binding #Main_SidePanelBorder.IsVisible}"/>

                    <Panel x:Name="Main_SidePanel" Grid.Column="4" HorizontalAlignment="Stretch">
                        <Border Classes="panelbackground" IsVisible="{Binding !#Main_SidePanelBorder.IsVisible}" CornerRadius="12,0,0,12" Width="50">
                            <StackPanel Spacing="10">
                                <Button Classes="button sidepanelbutton" Content="{materialIcons:MaterialIconExt Kind=TextSearch}" ToolTip.Tip="詳細検索" Tag="0" Click="SidePanel_Show_Click"/>
                                <Button Classes="button sidepanelbutton" Content="{materialIcons:MaterialIconExt Kind=DownloadMultiple}" ToolTip.Tip="一括インポート" Tag="1" Click="SidePanel_Show_Click"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="Main_SidePanelBorder" Classes="panelbackground" IsVisible="False" CornerRadius="12,0,0,12">
                            <Grid RowSpacing="10">
                                <Grid Grid.Row="2" ColumnSpacing="10">
                                    <TabControl x:Name="SidePanel_TabControl" HorizontalAlignment="Stretch" SelectedIndex="0" FontSize="18" Margin="0,0,-10,0" TabStripPlacement="Right">
                                        <TabItem Header="{materialIcons:MaterialIconExt Kind=TextSearch}" ToolTip.Tip="詳細検索" VerticalAlignment="Center" PointerPressed="SidePanel_Tab_Click">
                                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" VerticalAlignment="Stretch">
                                                <TextBlock Text="詳細検索" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                                <Separator Grid.Row="1" Background="#22000000"/>

                                                <ScrollViewer Grid.Row="2" VerticalAlignment="Stretch">
                                                    <StackPanel Spacing="20" Margin="0,10,10,0">
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="有効化" FontSize="15" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="AdvancedSearchPanel_Enable" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" IsCheckedChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="OR検索" FontSize="15" VerticalAlignment="Center"/>
                                                            <ToggleSwitch x:Name="AdvancedSearchPanel_OrSearch" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" IsCheckedChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="タイトル" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Title" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="タイトル" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="作者名" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Author" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="作者名" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Booth Id" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Booth" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="Booth Id" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="対応アバター" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Avatar" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="対応アバター" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="カテゴリー" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Category" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="カテゴリー" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="メモ" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Memo" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="メモ" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="フォルダー" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Folder" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="フォルダー" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ファイル" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_File" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="ファイル" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="実装アバター" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Implemented" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="実装アバター" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="未実装アバター" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_NotImplemented" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="未実装アバター" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="タグ" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_Tag" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="タグ" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="共通素体" FontSize="15" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="AdvancedSearchPanel_CommonAvatar" Grid.Row="2" Grid.Column="1" FontSize="14" Watermark="共通素体" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="Main_SearchValue_Changed"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </TabItem>

                                        <TabItem x:Name="SidePanel_BulkImportPanelTab" Header="{materialIcons:MaterialIconExt Kind=DownloadMultiple}" ToolTip.Tip="一括インポート" PointerPressed="SidePanel_Tab_Click">
                                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" VerticalAlignment="Stretch">
                                                <TextBlock Text="一括インポート" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                                <Separator Grid.Row="1" Background="#22000000"/>

                                                <Grid Grid.Row="2" RowDefinitions="*,Auto,Auto" RowSpacing="10" Margin="-10,0,-10,0" VerticalAlignment="Stretch">
                                                    <ScrollViewer x:Name="SidePanel_BulkImportPanelScrollViewer" Grid.Row="0" DragDrop.AllowDrop="True" DragDrop.Drop="BulkImportPanel_DragDrop_Drop">
                                                        <StackPanel x:Name="SidePanel_BulkImportPanel" Spacing="5" Margin="0,0,10,0"/>
                                                    </ScrollViewer>
                                                    <Button Grid.Row="1" Classes="accent" FontWeight="Bold" Content="インポート" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="42" CornerRadius="8" Click="BulkImportPanel_Import_Click"/>
                                                    <Button Grid.Row="2" Classes="button" FontWeight="Bold" Content="リセット" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="42" CornerRadius="8" Click="BulkImportPanel_Reset_Click"/>
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Grid>
                        </Border>
                    </Panel>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- 設定画面 -->
        <Border x:Name="SettingsOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="800" Height="600">
                <Grid RowDefinitions="*,5,Auto">
                    <TabControl Grid.Row="0" TabStripPlacement="Left">

                        <TabItem Header="基本" FontWeight="Bold">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="データ保存先フォルダ"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="フォルダの展開先です"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <TextBox x:Name="SettingsOverlay_ItemsFolderPathTextBox" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <Button Classes="button" Grid.Column="1" Content="参照" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Click="SettingsOverlay_OpenFolder_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="言語"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="ソフト内の言語です" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                                <ComboBox Grid.Column="1" x:Name="SettingsOverlay_LanguageComboBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                        

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="並び替え順"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="アイテムの並び順です"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                                <ComboBox Grid.Column="1" x:Name="SettingsOverlay_SortOrderComboBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="タイトル" Tag="UI.SortOrder.Title"/>
                                                    <ComboBoxItem Content="作者" Tag="UI.SortOrder.Author"/>
                                                    <ComboBoxItem Content="登録日時" Tag="UI.SortOrder.Created"/>
                                                    <ComboBoxItem Content="更新日時" Tag="UI.SortOrder.Updated"/>
                                                </ComboBox>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="テーマ"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="ソフト内で使用されるテーマです"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                                <ComboBox Grid.Column="1" x:Name="SettingsOverlay_ThemeComboBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="ダーク"/>
                                                    <ComboBoxItem Content="ライト"/>
                                                </ComboBox>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="表示" FontWeight="Bold">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="タイトルの括弧を削除する"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="アイテムタイトルの【】を削除します"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_RemoveBracketsCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="アイコンサイズ"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="通常時のアイコンサイズです"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,30" ColumnSpacing="5">
                                                <Slider x:Name="SettingsOverlay_NormalIconSizeSlider" Value="70" Minimum="0" Maximum="200" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <TextBlock Grid.Column="1" Text="{Binding #SettingsOverlay_NormalIconSizeSlider.Value, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="アイコンの拡大を有効化"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="アイコンにカーソルを当てた時にアイコンを拡大します"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_EnableHoverIconSizeCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding #SettingsOverlay_EnableHoverIconSizeCheckBox.IsChecked}">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="アイコンサイズ(拡大時)"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="拡大時のアイコンサイズです"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,30" ColumnSpacing="5">
                                                <Slider x:Name="SettingsOverlay_HoverIconSizeSlider" Value="200" Minimum="0" Maximum="800" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <TextBlock Grid.Column="1" Text="{Binding #SettingsOverlay_HoverIconSizeSlider.Value, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="アイコンのアンチエイリアス"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="アイコン画像の輪郭のギザギザをどれほど滑らかにするかの設定です"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*">
                                                <ComboBox Grid.Column="1" x:Name="SettingsOverlay_AntiAliasingModeComboBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                    <ComboBoxItem Content="無効"/>
                                                    <ComboBoxItem Content="低品質"/>
                                                    <ComboBoxItem Content="中品質"/>
                                                    <ComboBoxItem Content="高品質"/>
                                                </ComboBox>
                                            </Grid>
                                        </Grid>
                                        
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="ページあたりのアイテム表示数"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="1ページに表示する最大アイテム数です"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <TextBox Grid.Column="1" x:Name="SettingsOverlay_ItemsPerPageTextBox" Text="30" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="アイテム" FontWeight="Bold">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="インポート時に元ファイルを削除する"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="アイテムをインポートした時に、元ファイルを自動で削除するかどうかの設定です"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_RemoveOriginalCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="背景" FontWeight="Bold">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="カスタム背景を使用する"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="ソフトの背景を変更します"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <ToggleSwitch x:Name="SettingsOverlay_UseBackgroundImageCheckBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding #SettingsOverlay_UseBackgroundImageCheckBox.IsChecked}">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="背景写真ファイル"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="背景写真のパスです"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <TextBox x:Name="SettingsOverlay_BackgroundImagePathTextBox" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <Button Classes="button" Grid.Column="1" Content="参照" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Click="SettingsOverlay_OpenBackgroundFile_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding #SettingsOverlay_UseBackgroundImageCheckBox.IsChecked}">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="不透明度"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="背景画像の不透明度です"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,30" ColumnSpacing="5">
                                                <Slider x:Name="SettingsOverlay_BackgroundImageOpacitySlider" Value="20" Minimum="0" Maximum="100" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <TextBlock Grid.Column="1" Text="{Binding #SettingsOverlay_BackgroundImageOpacitySlider.Value, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="共通素体" FontWeight="Bold">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="共通素体の管理"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="共通素体の管理画面を開きます"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accent" Content="管理画面を開く" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_EditCommonAvatars_Click"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>

                        <TabItem Header="データ" FontWeight="Bold">
                            <Panel>
                                <ScrollViewer>
                                    <StackPanel Spacing="20" Margin="0,0,10,0">
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="自動バックアップ保存先"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="自動バックアップの保存先"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                                <TextBox x:Name="SettingsOverlay_AutoBackupPathTextBox" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                                                <Button Classes="button" Grid.Column="1" Content="参照" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Click="SettingsOverlay_OpenAutoBackupRootFolder_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="自動バックアップ頻度"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="自動バックアップの頻度(分)を設定します"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <TextBox Grid.Column="1" x:Name="SettingsOverlay_AutoBackupIntervalTextBox" Text="5" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="他のツールからインポート"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="現在のデータベースに追加でデータをインポートします"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accent" Content="インポート画面を開く" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ImportData_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="CSVデータの出力"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="現在のデータベースをCSV形式でエクスポートします"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accent" Content="エクスポート画面を開く" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ExportDataToCsv_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="自動バックアップから復元"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="自動バックアップからデータベース情報を復元します"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Classes="accent" Content="バックアップの選択" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_RestoreDataFromBackup_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="アイテムデータベースのリセット"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="アイテムのデータベースをリセットします。アセットデータ自体は削除されません。"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Background="Red" Foreground="White" FontWeight="Bold" Content="リセット" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ResetItemDatabase_Click"/>
                                            </Grid>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="5">
                                                <TextBlock Classes="settingslabel title" Grid.Row="0" Text="共通素体データベースのリセット"/>
                                                <TextBlock Classes="settingslabel description" Grid.Row="1" Text="共通素体のデータベースをリセットします。アセットデータ自体は削除されません。"/>
                                            </Grid>

                                            <Grid Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="5">
                                                <Button Grid.Column="1" Background="Red" Foreground="White" FontWeight="Bold" Content="リセット" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsOverlay_ResetCommonAvatarDatabase_Click"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Panel>
                        </TabItem>
                    </TabControl>

                    <!-- 下のボタン -->
                    <Grid Grid.Row="2" ColumnDefinitions="200,*,200" Margin="10,50,10,0">
                        <Button Classes="button" FontWeight="Bold" CornerRadius="20" Grid.Column="0" Content="閉じる" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15" Padding="10" Click="SettingsOverlay_Close_Click" />
                        <Button Classes="accent" FontWeight="Bold" CornerRadius="20" Grid.Column="2" Content="適用" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="15" Padding="10" Click="SettingsOverlay_Apply_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- アイテム追加画面 -->
        <Border x:Name="AddItemOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" CornerRadius="12">
                <Grid ColumnDefinitions="350,20,500">
                    <Grid Grid.Column="0" RowDefinitions="Auto,15,*">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Classes="accent" FontSize="12" Click="AddItemOverlay_AddFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FolderPlus" Width="20" Height="20"/>
                                    <TextBlock Text="フォルダを追加" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="accent" FontSize="12" Click="AddItemOverlay_AddFile_Click">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FilePlus" Width="20" Height="20"/>
                                    <TextBlock Text="ファイルを追加" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Row="2" Background="{DynamicResource Background.Sub}" CornerRadius="8" BorderBrush="#444" BorderThickness="1">
                            <ScrollViewer Padding="10">
                                <Grid x:Name="AddItemOverlay_FolderList"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Boothアイテム情報 -->
                    <StackPanel Grid.Column="2" Spacing="25">
                        <TextBlock Text="Booth アイテム情報" FontWeight="Bold" FontSize="22"/>

                        <StackPanel Spacing="15">
                            <Grid ColumnDefinitions="100,*,120" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="Booth URL" VerticalAlignment="Center" Opacity="0.7"/>
                                <TextBox x:Name="AddItemOverlay_BoothLinkTextBox" Grid.Column="1" Watermark="URLを入力..."/>
                                <Button Grid.Column="2" Content="情報取得" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="AddItemOverlay_GetBoothItemData_Click"/>
                            </Grid>

                            <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="タイトル" VerticalAlignment="Center" Opacity="0.7"/>
                                <TextBox x:Name="AddItemOverlay_BoothItemTitleTextBox" Grid.Column="1" Watermark="タイトル"/>
                            </Grid>

                            <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="作者" VerticalAlignment="Center" Opacity="0.7"/>
                                <TextBox x:Name="AddItemOverlay_BoothItemAuthorTextBox" Grid.Column="1" Watermark="作者名"/>
                            </Grid>
                        </StackPanel>

                        <UniformGrid Columns="2">
                            <StackPanel Spacing="8" Margin="0,0,10,0">
                                <TextBlock Text="タイプ" FontSize="13" Opacity="0.7"/>
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="5">
                                    <ComboBox x:Name="AddItemOverlay_ItemTypeComboBox" HorizontalAlignment="Stretch" SelectedIndex="0"/>
                                    <Button Grid.Column="1" Content="{materialIcons:MaterialIconExt Kind=TabPlus}" Width="35" Click="AddItemOverlay_AddCustomCategory_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="8" Margin="10,0,0,0">
                                <TextBlock Text="対応アバター" FontSize="13" Opacity="0.7"/>
                                <Button x:Name="AddItemOverlay_EditSupportedAvatarsButton" Content="選択中: 0 アバター" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" Click="AddItemOverlay_EditSupportedAvatars_Click"/>
                            </StackPanel>
                        </UniformGrid>

                        <Separator Background="#444" Height="1"/>

                        <StackPanel Spacing="10">
                            <CheckBox x:Name="AddItemOverlay_ShowInternalInfo" Content="詳細な内部情報を表示する" FontSize="13"/>
                            
                            <StackPanel IsVisible="{Binding #AddItemOverlay_ShowInternalInfo.IsChecked}" Spacing="12" Margin="10,5,0,0">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="作者ID" FontSize="12" Opacity="0.6"/>
                                        <TextBox x:Name="AddItemOverlay_InternalAuthorIdTextBox" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="Booth ID" FontSize="12" Opacity="0.6"/>
                                        <TextBox x:Name="AddItemOverlay_InternalBoothIdTextBox" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                                
                                <StackPanel Spacing="5">
                                    <TextBlock Text="画像 URL" FontSize="12" Opacity="0.6"/>
                                    <TextBox x:Name="AddItemOverlay_InternalImageURLTextBox" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Spacing="5">
                                    <TextBlock Text="作者画像 URL" FontSize="12" Opacity="0.6"/>
                                    <TextBox x:Name="AddItemOverlay_InternalAuthorImageURLTextBox" FontSize="13"/>
                                </StackPanel>
                                
                            </StackPanel>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="15" Margin="0,10,0,0">
                            <Button Grid.Column="1" Content="キャンセル" Width="120" Height="40" Classes="button" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="AddItemOverlay_Close_Click" />
                            <Button Grid.Column="2" Content="確定して保存" Width="120" Height="40" Classes="accent" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="AddItemOverlay_Confirm_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- 対応アバター編集画面 -->
        <Border x:Name="EditSupportedAvatarsOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="800">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,10,Auto,20,Auto">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="対応アバターの選択" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                        
                        <!-- 検索バー -->
                        <TextBox x:Name="EditSupportedAvatarsOverlay_SearchTextBox" Grid.Row="2" Watermark="検索" TextChanged="EditSupportedAvatarsOverlay_SearchTextBox_Changed"/>

                        <!-- アバターリスト -->
                        <ScrollViewer Grid.Row="4" Height="500">
                            <StackPanel x:Name="EditSupportedAvatarsOverlay_AvatarsList" Spacing="8" Margin="0,0,10,0"/>
                        </ScrollViewer>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="*,120,120" Grid.Row="6" Margin="10,0,10,0" ColumnSpacing="20">
                            <Button Classes="button" FontWeight="Bold" Grid.Column="1" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditSupportedAvatarsOverlay_Cancel_Click"/>
                            <Button Classes="accent" FontWeight="Bold" Grid.Column="2" Content="確定" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditSupportedAvatarsOverlay_Confirm_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 実装アバター編集画面 -->
        <Border x:Name="EditImplementedAvatarsOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="800">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,10,Auto,20,Auto">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="実装アバターの選択" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>
                        
                        <!-- 検索バー -->
                        <TextBox x:Name="EditImplementedAvatarsOverlay_SearchTextBox" Grid.Row="2" Watermark="検索" TextChanged="EditImplementedAvatarsOverlay_SearchTextBox_Changed"/>

                        <!-- アバターリスト -->
                        <ScrollViewer Grid.Row="4" Height="500">
                            <StackPanel x:Name="EditImplementedAvatarsOverlay_AvatarsList" Spacing="8" Margin="0,0,10,0"/>
                        </ScrollViewer>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="*,120,120" Grid.Row="6" Margin="10,0,10,0" ColumnSpacing="20">
                            <Button Classes="button" FontWeight="Bold" Grid.Column="1" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditImplementedAvatarsOverlay_Cancel_Click"/>
                            <Button Classes="accent" FontWeight="Bold" Grid.Column="2" Content="確定" VerticalAlignment="Center" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditImplementedAvatarsOverlay_Confirm_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 共通素体アバター編集画面 -->
        <Border x:Name="EditCommonAvatarsOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="800">
                <StackPanel Spacing="10">
                    <Grid RowDefinitions="Auto,20,Auto,30,Auto,10,Auto,20,Auto">

                        <!-- タイトル -->
                        <TextBlock Grid.Row="0" Text="共通素体アバターの管理" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>

                        <!-- グループ選択欄 -->
                        <Grid ColumnDefinitions="100,20,*,20,Auto,10,Auto,10,Auto" Margin="10,0,10,0" Grid.Row="2">
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="共通素体グループ" VerticalAlignment="Center" HorizontalAlignment="Left" FontWeight="Bold"/>
                            <ComboBox x:Name="EditCommonAvatarsOverlay_GroupComboBox" Grid.Column="2" SelectedIndex="0" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" SelectionChanged="EditCommonAvatarsOverlay_GroupComboBox_Changed"/>
                            <Button Classes="button" FontWeight="Bold" Grid.Column="4" Content="追加" VerticalAlignment="Center" HorizontalAlignment="Left" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Click="EditCommonAvatarsOverlay_AddGroup_Click"/>
                            <Button Classes="button" FontWeight="Bold" Grid.Column="6" Content="改名" VerticalAlignment="Center" HorizontalAlignment="Left" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Click="EditCommonAvatarsOverlay_RenameGroup_Click"/>
                            <Button Classes="button" FontWeight="Bold" Grid.Column="8" Content="削除" VerticalAlignment="Center" HorizontalAlignment="Left" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Click="EditCommonAvatarsOverlay_RemoveGroup_Click"/>
                        </Grid>
                        
                        <!-- 検索バー -->
                        <TextBox x:Name="EditCommonAvatarsOverlay_SearchTextBox" Grid.Row="4" Watermark="検索" TextChanged="EditCommonAvatarsOverlay_SearchTextBox_Changed"/>

                        <!-- アバターリスト -->
                        <ScrollViewer Grid.Row="6" Height="400">
                            <StackPanel x:Name="EditCommonAvatarsOverlay_AvatarsList" Spacing="8" Margin="0,0,10,0"/>
                        </ScrollViewer>

                        <!-- 下のボタン -->
                        <Grid ColumnDefinitions="*,120" Grid.Row="8">
                            <Button Classes="accent" FontWeight="Bold" Grid.Column="2" Content="閉じる" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditCommonAvatarsOverlay_Close_Click"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- アイテムメモ追加画面 -->
        <Border x:Name="AddMemoOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500">
                <StackPanel Spacing="15">
                    
                    <!-- タイトル -->
                    <TextBlock Text="メモの追加" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>

                    <!-- メモテキスト -->
                    <ScrollViewer Height="150">
                        <TextBox x:Name="AddMemoOverlay_MemoTextBox" Watermark="メモ" AcceptsReturn="True"/>
                    </ScrollViewer>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="100,*,100">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="AddMemoOverlay_Cancel_Click"/>
                        <Button Classes="accent" FontWeight="Bold" Grid.Column="2" Content="確定" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="AddMemoOverlay_Confirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- アイテムタグ編集画面 -->
        <Border x:Name="EditTagsOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="450">
                <StackPanel Spacing="15">

                    <!-- タイトル -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="アイテムタグの編集" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>

                    <!-- アイテムタグリスト -->
                    <ScrollViewer x:Name="EditTagsOverlay_TagListScrollViewer" Height="160" Margin="0,10,0,10">
                        <Panel>
                            <Border Background="{DynamicResource Background.Sub}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="10" Padding="10">
                                <WrapPanel x:Name="EditTagsOverlay_TagList" VerticalAlignment="Stretch" LineSpacing="5" ItemSpacing="5"/>
                            </Border>
                        </Panel>
                    </ScrollViewer>

                    <!-- タグの追加 -->
                    <TextBlock Text="タグの追加" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,80" ColumnSpacing="5">
                        <TextBox x:Name="EditTagsOverlay_TagTextBox" Grid.Column="0" Watermark="新しいタグ" KeyDown="EditTagsOverlay_TagTextBox_KeyDown"/>
                        <Button Grid.Column="1" Content="追加" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="EditTagsOverlay_AddTagButton_Click"/>
                    </Grid>
                    <ComboBox x:Name="EditTagsOverlay_TagComboBox" PlaceholderText="追加したいタグを選択してください" Grid.Row="8" HorizontalAlignment="Stretch" SelectionChanged="EditTagsOverlay_TagComboBox_SelectionChanged"/>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="100,*,100" Margin="0,10,0,0">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditTagsOverlay_Cancel_Click"/>
                        <Button Classes="accent" FontWeight="Bold" Grid.Column="2" Content="確定" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="EditTagsOverlay_Confirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- データインポート画面 -->
        <Border x:Name="SelectImportTypeOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="300">
                <StackPanel Spacing="10">

                    <!-- タイトル -->
                    <TextBlock Text="データをインポートする" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Margin="0,10,0,10"/>
                    
                    <!-- インポートタイプ選択ボタン -->
                    <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="Avatar Explorer V1.x.x" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="16" Padding="10" Click="SelectImportTypeOverlay_FromV1_Click"/>
                    <Button Classes="button" FontWeight="Bold" Grid.Column="2" Content="KonoAsset" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="16" Padding="10" Click="SelectImportTypeOverlay_FromKonoAsset_Click"/>
                    <Button Classes="button" FontWeight="Bold" Grid.Column="4" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="16" Padding="10" Click="SelectImportTypeOverlay_Cancel_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 進捗画面 -->
        <Border x:Name="ProgressOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="400">
                <StackPanel Spacing="20">

                    <!-- タイトル -->
                    <TextBlock x:Name="ProgressBarTitle" Text="読み込み中..." VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17" FontWeight="Bold" Margin="0,5,0,5"/>

                    <!-- 進捗バー -->
                    <ProgressBar x:Name="ProgressBar" Value="0" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- OKダイアログ -->
        <Border x:Name="DialogOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500">
                <StackPanel Spacing="15">

                    <!-- タイトル -->
                    <TextBlock x:Name="DialogTitle" Text="Dialog Title" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left"/>

                    <!-- 内容 -->
                    <Grid RowDefinitions="Auto" ColumnDefinitions="*" Margin="0,10,0,10">
                        <TextBlock x:Name="DialogContent" Text="Content" FontSize="17" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- OKボタン -->
                    <Button Classes="accent" FontWeight="Bold" Content="OK" Width="100" VerticalAlignment="Center" HorizontalAlignment="Right" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="Dialog_OK_Click"/>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- テキストダイアログ -->
        <Border x:Name="TextDialogOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500">
                <StackPanel Spacing="15">
                    
                    <!-- タイトル -->
                    <TextBlock x:Name="TextDialogOverlay_Title"  Text="Dialog Title" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="26" FontWeight="Bold"/>

                    <!-- テキスト -->
                    <TextBox x:Name="TextDialogOverlay_Content" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,10,0,10"/>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="100,*,100">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="キャンセル" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="TextDialogOverlay_Cancel_Click"/>
                        <Button Classes="accent" FontWeight="Bold" Grid.Column="2" Content="確定" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="TextDialogOverlay_Add_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Yes/Noダイアログ -->
        <Border x:Name="YesNoDialogOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500">
                <StackPanel Spacing="15">

                    <!-- タイトル -->
                    <TextBlock x:Name="YesNoDialogTitle" Text="Dialog Title" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left"/>

                    <!-- 内容 -->
                    <Grid RowDefinitions="Auto" ColumnDefinitions="*" Margin="0,10,0,10">
                        <TextBlock x:Name="YesNoDialogContent" Text="Content" FontSize="17" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                    </Grid>
                    
                    <!-- Yes/Noボタン -->
                    <Grid ColumnDefinitions="100,*,100">
                        <Button Classes="button" FontWeight="Bold" Grid.Column="0" Content="いいえ" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="YesNoDialog_No_Click"/>
                        <Button Classes="accent" FontWeight="Bold" Grid.Column="2" Content="はい" VerticalAlignment="Center" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0,7" FontSize="15" Click="YesNoDialog_Yes_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- アップデートダイアログ -->
        <Border x:Name="UpdateDialogOverlay" Classes="overlaybackground" IsVisible="False">
            <Border Classes="overlay" Width="500" Padding="20">
                <StackPanel Spacing="15">

                    <!-- タイトル + バージョンテキスト -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="アップデートが利用可能です" FontSize="22" FontWeight="Bold"/>
                        <TextBlock x:Name="UpdateDialogOverlay_VersionText" FontSize="12" Foreground="Gray"/>
                    </StackPanel>

                    <Separator Background="#22000000"/>

                    <!-- 更新履歴 -->
                    <TextBlock Text="更新内容:" FontSize="15" FontWeight="SemiBold"/>
                    <Border Classes="panelbackground" Height="200" Background="{DynamicResource Background.Sub}">
                        <ScrollViewer>
                            <TextBlock x:Name="UpdateDialogOverlay_UpdateContentText" FontSize="14" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- 下のボタン -->
                    <Grid ColumnDefinitions="*,10,120,10,120">
                        <Button Grid.Column="2" Classes="button" Content="後で通知" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="UpdateDialogOverlay_Later_Click"/>
                        <Button Grid.Column="4" Classes="accent" Content="今すぐ更新" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="UpdateDialogOverlay_UpdateNow_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
